<configuration scan="true" scanPeriod="30 seconds">
    <!-- Правило для цветного вывода -->
    <conversionRule conversionWord="highlight"
                    converterClass="ch.qos.logback.classic.color.HighlightingCompositeConverter"/>

    <!-- Консольный вывод с цветами -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Настройки для конкретных логгеров -->
    <logger name="org.jdbi" level="DEBUG"/>
    <logger name="io.javalin" level="INFO"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Корневой уровень -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>